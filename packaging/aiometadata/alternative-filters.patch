+
+export async function reviewNaturalFilterCandidates(
+  metas: any[], plan: FilterPlan, config: any,
+  generate?: (options: any) => Promise<any>,
+): Promise<any[]> {
+  if (!plan.anyOf?.length) return reviewSimpleCandidates(metas, plan, config, generate);
+  const accepted = new Set<any>();
+  for (const branch of plan.anyOf) {
+    const candidates = metas.filter(meta => matchSimpleMeta(meta, branch) === true);
+    if (!candidates.length) continue;
+    const reviewed = await reviewSimpleCandidates(candidates, branch, config, generate);
+    reviewed.forEach(meta => accepted.add(meta));
+  }
+  // Shared thematic conditions apply to the union as well. A language-only
+  // alternative never has to pass an unrelated thematic alternative.
+  return reviewSimpleCandidates(metas.filter(meta => accepted.has(meta)), plan, config, generate);
+}
