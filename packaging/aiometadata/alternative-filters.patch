+export function matchMeta(m: any, p: FilterPlan): boolean | null {
+  const common = matchSimpleMeta(m, p);
+  if (common === false || !p.anyOf?.length) return common;
+  const alternatives = p.anyOf.map(branch => matchSimpleMeta(m, branch));
+  if (alternatives.some(match => match === true)) return common;
+  return alternatives.some(match => match == null) ? null : false;
