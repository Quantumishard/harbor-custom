+// Make the cached path available even when all user hooks run at OUTPUT.
+// No shader, texture, sampler or pixel is changed by this hook.
+static struct pl_hook_res frame_cache_hint(void *priv,
+                                           const struct pl_hook_params *params)
+{
+    (void) priv;
+    (void) params;
+    return (struct pl_hook_res) { .output = PL_HOOK_SIG_NONE };
+}
+
+static const struct pl_hook frame_cache_hook = {
+    .stages = PL_HOOK_NATIVE,
+    .input = PL_HOOK_SIG_NONE,
+    .hook = frame_cache_hint,
+    .signature = UINT64_C(0x484152424f524643),
+};
